# Importing this file will set the StaticMbedOS_DIR variable
# to using StaticMbedOS v1.x.x compatibility layer

message(DEPRECATION "Importing StaticMbedOSConfig.cmake is deprecated. Please use StaticMbedOS-@MBED_TARGET@Config.cmake instead.")

set(StaticMbedOS_DIR "${CMAKE_CURRENT_LIST_DIR}/StaticMbedOS-@MBED_TARGET@")
