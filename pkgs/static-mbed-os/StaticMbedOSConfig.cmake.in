# Compatible layer of StaticMbedOS v1.x.x
# For find_package(StaticMbedOS) to work
# Newer projects should use StaticMbedOS-@MBED_TARGET@ package directly

message(DEPRECATION "Using StaticMbedOS v1.x.x compatibility layer is deprecated. Please use StaticMbedOS-@MBED_TARGET@ package directly.")
find_package(StaticMbedOS-@MBED_TARGET@)

if (NOT TARGET StaticMbedOS)
  add_library(StaticMbedOS ALIAS StaticMbedOS-@MBED_TARGET@)
endif()

if (NOT COMMAND static_mbed_os_app_target)
  function(static_mbed_os_app_target target)
    static_mbed_os_@MBED_TARGET_LOWER@_app_target(${target})
  endfunction()
endif()
